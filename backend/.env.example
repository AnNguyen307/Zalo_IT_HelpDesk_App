PORT=8080
NODE_ENV=development
# local | free-hosting | nas. Hosted profiles fail fast on unsafe settings.
DEPLOYMENT_PROFILE=local
APP_SECRET=replace-with-a-long-random-secret-at-least-32-characters
TECHNICIAN_PASSWORD=CHANGE_ME_TECHNICIAN_PASSWORD
ADMIN_PASSWORD=CHANGE_ME_STRONG_BOOTSTRAP_PASSWORD
# Giữ true trong lần nâng cấp đầu để không khóa tài khoản quản trị cũ.
# Sau khi tạo tài khoản riêng, đổi false để tắt mật khẩu kỹ thuật viên dùng chung.
LEGACY_STAFF_LOGIN_ENABLED=true

# development: suitable for local pilot only.
# zalo: verifies the access token directly with Zalo Open API + appsecret_proof.
# remote: calls a separately operated ZALO_TOKEN_VERIFY_URL.
ZALO_AUTH_MODE=development
ZALO_APP_SECRET=
ZALO_MINI_APP_ID=4185582976193315701
# Open API Key chỉ lưu ở backend secret store; dùng để xác thực X-ZEvent-Signature.
ZALO_OPEN_API_KEY=
ZALO_PROFILE_URL=https://graph.zalo.me/v2.0/me
ZALO_TOKEN_VERIFY_URL=
ZALO_VERIFY_TIMEOUT_MS=7000

# Dùng * trong giai đoạn test Zalo/ngrok. Khi production hãy giới hạn origin.
ALLOWED_ORIGINS=*
SESSION_TTL_HOURS=168
# Mini App: access token ngắn hạn + refresh session trượt, tối đa 90 ngày.
USER_ACCESS_TTL_MINUTES=60
USER_REFRESH_TTL_DAYS=90
# Mã mời chưa sử dụng mặc định hết hạn sau 24 giờ.
USER_INVITE_TTL_HOURS=24

# Database provider: json, sqlserver or postgres.
# postgres is the v5.15 free-hosting state store; SQL Server remains the NAS store.
DB_PROVIDER=sqlserver
DATA_FILE=./data/db.json

# PostgreSQL pilot state store. Keep the connection string only in the backend secret store.
POSTGRES_URL=
POSTGRES_SSL_MODE=require
POSTGRES_POOL_MAX=4
POSTGRES_CONNECTION_TIMEOUT_MS=15000
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_STATEMENT_TIMEOUT_MS=30000

# SQL Server connection. Prefer a dedicated application login with least privilege.
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
# Set only for a named instance such as SQLEXPRESS. When set, SQLSERVER_PORT is ignored.
SQLSERVER_INSTANCE=
SQLSERVER_DATABASE=ZaloHelpDesk
# sql: SQL Server login; ntlm: domain/user/password through the Tedious driver.
SQLSERVER_AUTH=sql
SQLSERVER_USER=zalo_helpdesk_app
SQLSERVER_PASSWORD=CHANGE_ME
SQLSERVER_DOMAIN=
# Local SQL Server normally uses false + trust certificate true.
# For remote/production SQL Server, enable encryption and install a trusted certificate.
SQLSERVER_ENCRYPT=false
SQLSERVER_TRUST_SERVER_CERTIFICATE=true
SQLSERVER_CONNECTION_TIMEOUT_MS=15000
SQLSERVER_REQUEST_TIMEOUT_MS=30000
SQLSERVER_POOL_MAX=10
SQLSERVER_POOL_MIN=0
SQLSERVER_POOL_IDLE_TIMEOUT_MS=30000

# filesystem for local/NAS; supabase for free-hosting because the container disk is ephemeral.
ATTACHMENT_STORAGE_PROVIDER=filesystem
UPLOADS_DIR=./data/uploads
ATTACHMENT_TEMP_DIR=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=helpdesk-attachments
# Toàn hệ thống chỉ giữ tối đa 30 ticket. Ticket thứ 31 thay ticket resolved/closed cũ nhất.
MAX_STORED_TICKETS=30
# Tổng tất cả ảnh/file của một ticket không vượt quá 10 MB.
MAX_TICKET_ATTACHMENT_MB=10
# Một file và một lần phản hồi cũng không được vượt ngân sách 10 MB/ticket.
MAX_ATTACHMENT_MB=10
MAX_REPLY_UPLOAD_MB=10
# Chỉ dành cho client cũ còn gửi JSON/Base64; Mini App hiện tại dùng multipart streaming.
MAX_LEGACY_JSON_UPLOAD_MB=32
MAX_ATTACHMENTS_PER_TICKET=8
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_MAX=120
RATE_LIMIT_INVITE_MAX=10
RATE_LIMIT_WRITE_MAX=240
RATE_LIMIT_UPLOAD_MAX=60
RATE_LIMIT_MAX_KEYS=10000
REOPEN_WINDOW_DAYS=14
NOTIFICATION_POLL_SECONDS=20
OVERDUE_CHECK_SECONDS=60

# SLA tính trong giờ làm việc, đơn vị phút. 0=Chủ nhật, 1=Thứ hai ... 6=Thứ bảy.
SLA_TIME_ZONE=Asia/Ho_Chi_Minh
SLA_WORK_DAYS=1,2,3,4,5
SLA_WORK_START=08:00
SLA_WORK_END=17:30
# Ngày nghỉ bổ sung, cách nhau bằng dấu phẩy. Ví dụ: 2026-09-02,2027-01-01
SLA_HOLIDAYS=
SLA_LOW_FIRST_RESPONSE_MINUTES=480
SLA_LOW_RESOLUTION_MINUTES=4320
SLA_NORMAL_FIRST_RESPONSE_MINUTES=240
SLA_NORMAL_RESOLUTION_MINUTES=1440
SLA_HIGH_FIRST_RESPONSE_MINUTES=120
SLA_HIGH_RESOLUTION_MINUTES=480
SLA_URGENT_FIRST_RESPONSE_MINUTES=30
SLA_URGENT_RESOLUTION_MINUTES=240

# AI Router V2 v5.14.0 dùng cloud provider; Rules/HelpDesk là fallback vận hành.
# Đặt AI_ROUTER_ENABLED=false để rollback về AI_PROVIDER đơn lẻ hoặc rules.
AI_ROUTER_ENABLED=true
AI_PROVIDER_ORDER=gemini,groq,openrouter,sambanova
# fixed giữ đúng thứ tự Gemini -> Groq -> OpenRouter -> SambaNova.
AI_ROUTING_POLICY=fixed
AI_PROVIDER=rules
AGENT_MODE=rules
AI_CLOUD_ENABLED=true
# Bắt buộc che dữ liệu nhạy cảm trước khi gửi ticket đến cloud provider.
AI_REDACTION_ENABLED=true
AI_QUALITY_RETENTION_DAYS=180
AI_PROVIDER_RETRIES=1
AI_CIRCUIT_FAILURE_THRESHOLD=2
AI_CIRCUIT_COOLDOWN_MS=60000
AUTO_RESOLVE_THRESHOLD=0.78
AGENT_STRICT_ESCALATION=true
AGENT_REQUIRE_PLAYBOOK=true
AGENT_MIN_CONFIDENCE=0.82
# Chỉ dán bốn API key vào các dòng *_API_KEY bên dưới trong backend/.env.
# Không đưa key vào Mini App/Admin frontend, .env.example hoặc commit lên Git.
GEMINI_ENABLED=true
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=60000
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_OUTPUT_TOKENS=4096
# 0 = không áp ngân sách cứng trong app; quota thật vẫn do project Gemini quyết định.
# Gemini trả usageMetadata để đếm token đã dùng nhưng không bảo đảm có header quota còn lại; xem quota project trong AI Studio.
GEMINI_DAILY_REQUEST_LIMIT=0
GEMINI_DAILY_TOKEN_LIMIT=0
GROQ_ENABLED=true
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_MS=60000
GROQ_TEMPERATURE=0.1
GROQ_MAX_OUTPUT_TOKENS=4096
GROQ_DAILY_REQUEST_LIMIT=1000
GROQ_DAILY_TOKEN_LIMIT=200000
OPENROUTER_ENABLED=true
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_TIMEOUT_MS=60000
OPENROUTER_TEMPERATURE=0.1
OPENROUTER_MAX_OUTPUT_TOKENS=4096
OPENROUTER_DAILY_REQUEST_LIMIT=50
OPENROUTER_DAILY_TOKEN_LIMIT=0
SAMBANOVA_ENABLED=true
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=DeepSeek-V3.2
SAMBANOVA_TIMEOUT_MS=60000
SAMBANOVA_TEMPERATURE=0.1
SAMBANOVA_MAX_OUTPUT_TOKENS=4096
SAMBANOVA_DAILY_REQUEST_LIMIT=20
SAMBANOVA_DAILY_TOKEN_LIMIT=200000
AGENT_HISTORY_MESSAGES=12
AGENT_STATUS_CACHE_MS=10000
# Enterprise Playbook RAG: BM25 lexical không cần AI hoặc embedding service.
PLAYBOOK_ENABLED=true
PLAYBOOK_FILE=./playbooks/enterprise-playbook.json
PLAYBOOK_INDEX_FILE=./data/playbook-index.json
PLAYBOOK_RETRIEVAL_MODE=lexical
# none | gemini. Dùng none để chạy BM25 thuần túy.
PLAYBOOK_EMBED_PROVIDER=none
PLAYBOOK_SEMANTIC=false
PLAYBOOK_AUTO_INDEX=false
PLAYBOOK_EMBED_MODEL=none
PLAYBOOK_EMBED_TIMEOUT_MS=120000
PLAYBOOK_EMBED_BATCH_SIZE=12
PLAYBOOK_TOP_K=5
PLAYBOOK_MIN_SCORE=0.20
PLAYBOOK_AUTO_MIN_SCORE=0.72
PLAYBOOK_LEXICAL_WEIGHT=0.35
PLAYBOOK_MAX_ENTRY_CHARS=10000


# Playbook lifecycle governance (SQL Server)
PLAYBOOK_GOVERNANCE_ENABLED=true
PLAYBOOK_GOVERNANCE_CACHE_MS=5000
PLAYBOOK_AUTO_REINDEX_ON_PUBLISH=true

# Reply composer
MAX_ATTACHMENTS_PER_REPLY=4
