NODE_ENV=production
DEPLOYMENT_PROFILE=nas
PORT=8080
APP_SECRET=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ALLOWED_ORIGINS=https://h5.zdn.vn

DB_PROVIDER=sqlserver
SQLSERVER_HOST=host.docker.internal
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=ZaloHelpDesk
SQLSERVER_AUTH=sql
SQLSERVER_USER=zalo_helpdesk_app
SQLSERVER_PASSWORD=CHANGE_ME
SQLSERVER_ENCRYPT=true
SQLSERVER_TRUST_SERVER_CERTIFICATE=false

ATTACHMENT_STORAGE_PROVIDER=filesystem
UPLOADS_DIR=/app/data/uploads
PLAYBOOK_INDEX_FILE=/app/data/playbook-index.json
MAX_STORED_TICKETS=30
MAX_TICKET_ATTACHMENT_MB=10
MAX_ATTACHMENT_MB=10
MAX_REPLY_UPLOAD_MB=10

ZALO_AUTH_MODE=zalo
ZALO_APP_SECRET=CHANGE_ME_ZALO_APP_SECRET

# Bootstrap only: create a named Admin account, then set this to false.
LEGACY_STAFF_LOGIN_ENABLED=true
ADMIN_PASSWORD=CHANGE_ME_STRONG_BOOTSTRAP_PASSWORD

AI_CLOUD_ENABLED=false
AI_REDACTION_ENABLED=true
PLAYBOOK_GOVERNANCE_ENABLED=true
