{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "HelpDesk: Ollama AI",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\windows\\start-ollama.ps1",
        "-Model",
        "qwen3.5:9b"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true,
        "close": false
      },
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "silent"
      }
    },
    {
      "label": "HelpDesk: Backend",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\windows\\wait-ollama-start-backend.ps1",
        "-Model",
        "qwen3.5:9b",
        "-WaitSeconds",
        "90"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true,
        "close": false
      },
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "silent"
      }
    },
    {
      "label": "HelpDesk: ngrok",
      "type": "process",
      "command": "${env:USERPROFILE}\\Downloads\\ngrok-v3-stable-windows-amd64\\ngrok.exe",
      "args": [
        "http",
        "8080"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true,
        "close": false
      },
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "silent"
      }
    },
    {
      "label": "HelpDesk: Đồng bộ URL + Deploy",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\windows\\sync-ngrok-url.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true,
        "close": false
      },
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "silent"
      }
    },
    {
      "label": "HelpDesk: Khởi động toàn bộ",
      "dependsOn": [
        "HelpDesk: Ollama AI",
        "HelpDesk: Backend",
        "HelpDesk: ngrok",
        "HelpDesk: Đồng bộ URL + Deploy"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false
      },
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "silent",
        "runOn": "folderOpen"
      }
    },
    {
      "label": "HelpDesk: Cài/kiểm tra AI Agent",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\windows\\install-ai-agent.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true,
        "close": false
      },
      "runOptions": {
        "instanceLimit": 1,
        "instancePolicy": "silent"
      }
    },
    {
      "label": "HelpDesk: Dừng backend và ngrok",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "$project = '${workspaceFolder}'.ToLowerInvariant(); Get-CimInstance Win32_Process | Where-Object { ($_.Name -in @('node.exe','ngrok.exe')) -and ((([string]$_.CommandLine).ToLowerInvariant().Contains($project)) -or $_.Name -eq 'ngrok.exe') } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }; Write-Host 'Đã dừng backend/ngrok.'"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true,
        "close": false
      }
    },
    {
      "label": "HelpDesk: Cai dat Enterprise Playbook",
      "type": "shell",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\windows\\install-enterprise-playbook.ps1"
      ],
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "group": "helpdesk",
        "reveal": "always",
        "clear": true
      }
    }
  ]
}
